# /etc/biomonitor-router.env — systemd EnvironmentFile for biomonitor-router.service
ROUTER_INGEST_ADDR=0.0.0.0:9100
ROUTER_HTTP_ADDR=0.0.0.0:7300
ROUTER_STORE_DIR=/var/lib/biomonitor-router/store
# SD card only on rp5ai: keep the cap small. Raise when an SSD is mounted at the store dir.
ROUTER_STORE_MAX_GB=40
ROUTER_EMULATOR_ADDR=192.168.0.125:5445
ROUTER_WEB_DIR=/opt/biomonitor-router/web
ROUTER_GROUPS_PATH=/var/lib/biomonitor-router/groups.json
ROUTER_DISPLAYS_PATH=/var/lib/biomonitor-router/displays.json
RUST_LOG=info
